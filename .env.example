# Публичный адрес почты. Заполнить только подтверждённым адресом — до этого почта на сайте не показывается.
NEXT_PUBLIC_CONTACT_EMAIL=

# Куда пересылать обращения из формы (webhook: CRM, Telegram-бот, почтовый сервис и т. п.).
# Пока переменная пуста, форма честно сообщает, что отправка не подключена.
CONTACT_WEBHOOK_URL=

# Подключение доставки сообщений из чата. Пока false — чат работает в режиме демонстрации.
NEXT_PUBLIC_CHAT_DELIVERY_ENABLED=false
